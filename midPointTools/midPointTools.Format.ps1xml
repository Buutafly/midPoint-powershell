<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <ViewDefinitions>
    <View>
      <Name>midPointTools.User</Name>
      <ViewSelectedBy><TypeName>midPointTools.User</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Name</Label></TableColumnHeader>
          <TableColumnHeader><Label>FullName</Label></TableColumnHeader>
          <TableColumnHeader><Label>EmailAddress</Label></TableColumnHeader>
          <TableColumnHeader><Label>EffectiveStatus</Label></TableColumnHeader>
          <TableColumnHeader><Label>Oid</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>FullName</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>EmailAddress</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>EffectiveStatus</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Oid</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>midPointTools.Activation</Name>
      <ViewSelectedBy><TypeName>midPointTools.Activation</TypeName></ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem><PropertyName>Name</PropertyName></ListItem>
              <ListItem><PropertyName>AdministrativeStatus</PropertyName></ListItem>
              <ListItem><PropertyName>EffectiveStatus</PropertyName></ListItem>
              <ListItem><PropertyName>ValidityStatus</PropertyName></ListItem>
              <ListItem><PropertyName>ValidFrom</PropertyName></ListItem>
              <ListItem><PropertyName>ValidTo</PropertyName></ListItem>
              <ListItem><PropertyName>DisableReason</PropertyName></ListItem>
              <ListItem><PropertyName>DisableTimestamp</PropertyName></ListItem>
              <ListItem><PropertyName>EnableTimestamp</PropertyName></ListItem>
              <ListItem><PropertyName>LockoutStatus</PropertyName></ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>
    <View>
      <Name>midPointTools.Role</Name>
      <ViewSelectedBy><TypeName>midPointTools.Role</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Name</Label></TableColumnHeader>
          <TableColumnHeader><Label>DisplayName</Label></TableColumnHeader>
          <TableColumnHeader><Label>Oid</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>DisplayName</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Oid</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>midPointTools.RoleAssignment</Name>
      <ViewSelectedBy><TypeName>midPointTools.RoleAssignment</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>User</Label></TableColumnHeader>
          <TableColumnHeader><Label>Role</Label></TableColumnHeader>
          <TableColumnHeader><Label>Relation</Label></TableColumnHeader>
          <TableColumnHeader><Label>Id</Label></TableColumnHeader>
          <TableColumnHeader><Label>EffectiveStatus</Label></TableColumnHeader>
          <TableColumnHeader><Label>ValidFrom</Label></TableColumnHeader>
          <TableColumnHeader><Label>ValidTo</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>User</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Role</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Relation</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>AssignmentId</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>EffectiveStatus</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>ValidFrom</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>ValidTo</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>midPointTools.Org</Name>
      <ViewSelectedBy><TypeName>midPointTools.Org</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Name</Label></TableColumnHeader>
          <TableColumnHeader><Label>DisplayName</Label></TableColumnHeader>
          <TableColumnHeader><Label>Identifier</Label></TableColumnHeader>
          <TableColumnHeader><Label>Oid</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>DisplayName</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Identifier</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Oid</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>midPointTools.OrgAssignment</Name>
      <ViewSelectedBy><TypeName>midPointTools.OrgAssignment</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>User</Label></TableColumnHeader>
          <TableColumnHeader><Label>Org</Label></TableColumnHeader>
          <TableColumnHeader><Label>Relation</Label></TableColumnHeader>
          <TableColumnHeader><Label>Id</Label></TableColumnHeader>
          <TableColumnHeader><Label>EffectiveStatus</Label></TableColumnHeader>
          <TableColumnHeader><Label>ValidFrom</Label></TableColumnHeader>
          <TableColumnHeader><Label>ValidTo</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>User</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Org</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Relation</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>AssignmentId</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>EffectiveStatus</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>ValidFrom</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>ValidTo</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>midPointTools.Shadow</Name>
      <ViewSelectedBy><TypeName>midPointTools.Shadow</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>User</Label></TableColumnHeader>
          <TableColumnHeader><Label>Resource</Label></TableColumnHeader>
          <TableColumnHeader><Label>Name</Label></TableColumnHeader>
          <TableColumnHeader><Label>Kind</Label></TableColumnHeader>
          <TableColumnHeader><Label>Intent</Label></TableColumnHeader>
          <TableColumnHeader><Label>Situation</Label></TableColumnHeader>
          <TableColumnHeader><Label>Exists</Label></TableColumnHeader>
          <TableColumnHeader><Label>Pending</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>User</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Resource</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Kind</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Intent</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Situation</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Exists</PropertyName></TableColumnItem>
              <TableColumnItem><ScriptBlock>$_.PendingOperation -join ', '</ScriptBlock></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>midPointTools.Resource</Name>
      <ViewSelectedBy><TypeName>midPointTools.Resource</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Name</Label></TableColumnHeader>
          <TableColumnHeader><Label>ConnectorType</Label></TableColumnHeader>
          <TableColumnHeader><Label>Oid</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>ConnectorType</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Oid</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>midPointTools.Case</Name>
      <ViewSelectedBy><TypeName>midPointTools.Case</TypeName></ViewSelectedBy>
      <TableControl>
        <TableHeaders>
          <TableColumnHeader><Label>Name</Label></TableColumnHeader>
          <TableColumnHeader><Label>State</Label></TableColumnHeader>
          <TableColumnHeader><Label>Outcome</Label></TableColumnHeader>
          <TableColumnHeader><Label>OpenWorkItems</Label></TableColumnHeader>
          <TableColumnHeader><Label>Oid</Label></TableColumnHeader>
        </TableHeaders>
        <TableRowEntries>
          <TableRowEntry>
            <TableColumnItems>
              <TableColumnItem><PropertyName>Name</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>State</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Outcome</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>OpenWorkItems</PropertyName></TableColumnItem>
              <TableColumnItem><PropertyName>Oid</PropertyName></TableColumnItem>
            </TableColumnItems>
          </TableRowEntry>
        </TableRowEntries>
      </TableControl>
    </View>
    <View>
      <Name>midPointTools.Session</Name>
      <ViewSelectedBy><TypeName>midPointTools.Session</TypeName></ViewSelectedBy>
      <ListControl>
        <ListEntries>
          <ListEntry>
            <ListItems>
              <ListItem><PropertyName>Uri</PropertyName></ListItem>
              <ListItem><PropertyName>UserName</PropertyName></ListItem>
              <ListItem><PropertyName>AuthType</PropertyName></ListItem>
              <ListItem>
                <PropertyName>TokenExpiresAt</PropertyName>
                <ItemSelectionCondition><ScriptBlock>$_.AuthType -eq 'Bearer'</ScriptBlock></ItemSelectionCondition>
              </ListItem>
              <ListItem><PropertyName>SkipCertificateCheck</PropertyName></ListItem>
              <ListItem><PropertyName>TimeoutSec</PropertyName></ListItem>
              <ListItem><PropertyName>ConnectedAt</PropertyName></ListItem>
            </ListItems>
          </ListEntry>
        </ListEntries>
      </ListControl>
    </View>
  </ViewDefinitions>
</Configuration>
